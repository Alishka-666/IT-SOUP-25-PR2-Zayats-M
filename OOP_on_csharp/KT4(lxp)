        Point3D a3 = new Point3D { X = 1, Y = 2, Z = 3 };
        Point3D b3 = new Point3D { X = 4, Y = 6, Z = 8 };
        Console.WriteLine("Расстояние 3D: " + a3.Distance(b3));

        ChessPiece piece = new ChessPiece { Name = "Конь", Position = "E4" };
        piece.Move("F6");
