using System;

struct Point
{
    public double X, Y;

    public double Distance(Point p)
    {
        return Math.Sqrt((X - p.X) * (X - p.X) + (Y - p.Y) * (Y - p.Y));
    }
}

struct Rectangle
{
    public double Width, Height;

    public double Area()
    {
        return Width * Height;
    }

    public double Perimeter()
    {
        return 2 * (Width + Height);
    }
}

struct Book
{
    public string Title, Author;
    public int Year;
}

struct ComplexNumber
{
    public double Real, Imag;

    public ComplexNumber Add(ComplexNumber c)
    {
        return new ComplexNumber { Real = Real + c.Real, Imag = Imag + c.Imag };
    }

    public ComplexNumber Subtract(ComplexNumber c)
    {
        return new ComplexNumber { Real = Real - c.Real, Imag = Imag - c.Imag };
    }

    public ComplexNumber Multiply(ComplexNumber c)
    {
        return new ComplexNumber
        {
            Real = Real * c.Real - Imag * c.Imag,
            Imag = Real * c.Imag + Imag * c.Real
        };
    }
}

struct Color
{
    public int R, G, B;

    public string ToHex()
    {
        return "#" + R.ToString("X2") + G.ToString("X2") + B.ToString("X2");
    }
}

struct SimpleDate
{
    public int Day, Month, Year;

    public bool IsLeapYear()
    {
        return Year % 400 == 0 || (Year % 4 == 0 && Year % 100 != 0);
    }
}

struct Vector2D
{
    public double X, Y;

    public double Length()
    {
        return Math.Sqrt(X * X + Y * Y);
    }

    public Vector2D Normalize()
    {
        double len = Length();
        return new Vector2D { X = X / len, Y = Y / len };
    }

    public double Dot(Vector2D v)
    {
        return X * v.X + Y * v.Y;
    }
}

struct Money
{
    public int Rubles, Kopecks;

    public int Total()
    {
        return Rubles * 100 + Kopecks;
    }

    public Money Add(Money m)
    {
        int t = Total() + m.Total();
        return new Money { Rubles = t / 100, Kopecks = t % 100 };
    }

    public Money Subtract(Money m)
    {
        int t = Total() - m.Total();
        return new Money { Rubles = t / 100, Kopecks = t % 100 };
    }

    public bool IsGreater(Money m)
    {
        return Total() > m.Total();
    }

    public bool IsLess(Money m)
    {
        return Total() < m.Total();
    }
}

struct Triangle
{
    public Point A, B, C;

    public double SideAB()
    {
        return A.Distance(B);
    }

    public double SideBC()
    {
        return B.Distance(C);
    }

    public double SideCA()
    {
        return C.Distance(A);
    }

    public double Perimeter()
    {
        return SideAB() + SideBC() + SideCA();
    }

    public double Area()
    {
        double p = Perimeter() / 2;
        return Math.Sqrt(p * (p - SideAB()) * (p - SideBC()) * (p - SideCA()));
    }
}

struct Point3D
{
    public double X, Y, Z;

    public double Distance(Point3D p)
    {
        return Math.Sqrt((X - p.X) * (X - p.X) + (Y - p.Y) * (Y - p.Y) + (Z - p.Z) * (Z - p.Z));
    }
}

struct ChessPiece
{
    public string Name, Position;

    public void Move(string newPosition)
    {
        Position = newPosition;
    }
}

struct GeoPoint
{
    public double Latitude, Longitude;

    public double Distance(GeoPoint g)
    {
        double lat1 = Latitude * Math.PI / 180;
        double lat2 = g.Latitude * Math.PI / 180;
        double dLat = lat2 - lat1;
        double dLon = (g.Longitude - Longitude) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1) * Math.Cos(lat2) * Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return 6371 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }
}

