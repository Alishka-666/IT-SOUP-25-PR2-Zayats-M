// 7. Вектор в 2D
struct Vector2D
{
    public double X;
    public double Y;

    public Vector2D(double x, double y)
    {
        X = x;
        Y = y;
    }

    // длина вектора
    public double Length()
    {
        return Math.Sqrt(X * X + Y * Y);
    }

    // нормализация - делим каждую координату на длину
    public Vector2D Normalize()
    {
        double len = Length();
        if (len == 0)
            return new Vector2D(0, 0); // чтобы не делить на ноль
        return new Vector2D(X / len, Y / len);
    }

    // скалярное произведение
    public double Dot(Vector2D other)
    {
        return X * other.X + Y * other.Y;
    }
}

// 8. Деньги
struct Money
{
    public int Rubles;
    public int Kopecks;

    public Money(int rubles, int kopecks)
    {
        // если копеек 100 или больше - переводим в рубли
        Rubles = rubles + kopecks / 100;
        Kopecks = kopecks % 100;
    }

    // переводим всё в копейки, так считать проще
    public int TotalKopecks()
    {
        return Rubles * 100 + Kopecks;
    }

    public Money Add(Money other)
    {
        int total = TotalKopecks() + other.TotalKopecks();
        return new Money(0, total);
    }

    public Money Subtract(Money other)
    {
        int total = TotalKopecks() - other.TotalKopecks();
        if (total < 0)
        {
            Console.WriteLine("Внимание: результат отрицательный, возвращаю 0");
            total = 0;
        }
        return new Money(0, total);
    }

    // true, если эта сумма больше другой
    public bool IsGreaterThan(Money other)
    {
        return TotalKopecks() > other.TotalKopecks();
    }

    // true, если эта сумма меньше другой
    public bool IsLessThan(Money other)
    {
        return TotalKopecks() < other.TotalKopecks();
    }

    public void Print()
    {
        // D2 - всегда две цифры (5 копеек будет "05")
        Console.WriteLine(Rubles + " руб. " + Kopecks.ToString("D2") + " коп.");
    }
}

// 9. Треугольник (использует структуру Point)
struct Triangle
{
    public Point A;
    public Point B;
    public Point C;

    public Triangle(Point a, Point b, Point c)
    {
        A = a;
        B = b;
        C = c;
    }

    // длины сторон
    public double SideAB()
    {
        return A.DistanceTo(B);
    }

    public double SideBC()
    {
        return B.DistanceTo(C);
    }

    public double SideCA()
    {
        return C.DistanceTo(A);
    }

    public double Perimeter()
    {
        return SideAB() + SideBC() + SideCA();
    }

    // формула Герона: S = sqrt(p * (p-a) * (p-b) * (p-c)), p - полупериметр
    public double Area()
    {
        double a = SideAB();
        double b = SideBC();
        double c = SideCA();
        double p = (a + b + c) / 2;
        return Math.Sqrt(p * (p - a) * (p - b) * (p - c));
    }
}

// 10. Точка в 3D
struct Point3D
{
    public double X;
    public double Y;
    public double Z;

    public Point3D(double x, double y, double z)
    {
        X = x;
        Y = y;
        Z = z;
    }

    public double DistanceTo(Point3D other)
    {
        double dx = other.X - X;
        double dy = other.Y - Y;
        double dz = other.Z - Z;
        return Math.Sqrt(dx * dx + dy * dy + dz * dz);
    }
}

