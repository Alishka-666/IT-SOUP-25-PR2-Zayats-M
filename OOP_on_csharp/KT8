// 12. GPS-координаты
struct GeoPoint
{
    public double Latitude;
    public double Longitude;

    public GeoPoint(double latitude, double longitude)
    {
        Latitude = latitude;
        Longitude = longitude;
    }

    // формула гаверсинусов, результат в километрах
    public double DistanceTo(GeoPoint other)
    {
        double earthRadius = 6371; // радиус Земли в км

        // переводим градусы в радианы
        double lat1 = Latitude * Math.PI / 180;
        double lat2 = other.Latitude * Math.PI / 180;
        double dLat = (other.Latitude - Latitude) * Math.PI / 180;
        double dLon = (other.Longitude - Longitude) * Math.PI / 180;

        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1) * Math.Cos(lat2) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));

        return earthRadius * c;
    }
}

