using System;
using System.Collections.Generic;
using System.Text;

// Интерфейс - это "договор": любой класс, который его использует,
// обязан написать метод Send
public interface INotifier
{
    void Send(string message);
}

// Отправка по email
public class EmailNotifier : INotifier
{
    public void Send(string message)
    {
        Console.WriteLine("Email: " + message);
    }
}

// Отправка по SMS
public class SmsNotifier : INotifier
{
    public void Send(string message)
    {
        Console.WriteLine("SMS: " + message);
    }
}

// Отправка в Telegram (дополнительно)
public class TelegramNotifier : INotifier
{
    public void Send(string message)
    {
        Console.WriteLine("Telegram: " + message);
    }
}

class Program
{
    static void Main()
    {
        // чтобы русские буквы нормально показывались в консоли
        Console.OutputEncoding = Encoding.UTF8;

        // список уведомителей
        List<INotifier> notifiers = new List<INotifier>
        {
            new EmailNotifier(),
            new SmsNotifier(),
            new TelegramNotifier()
        };

        // отправляем одно и то же сообщение через все каналы
        foreach (var notifier in notifiers)
        {
            notifier.Send("Интерфейсы — это круто!");
        }
    }
}
