using System;
using System.Text;

// ===== Часть 1. Обобщённый класс =====

// T - это "любой тип". Какой именно, мы решаем, когда создаём объект
class Box<T>
{
    private T item; // здесь лежит элемент

    // положить элемент в коробку
    public void Put(T newItem)
    {
        item = newItem;
    }

    // достать элемент из коробки
    public T Get()
    {
        return item;
    }
}

// ===== Часть 2. Обобщённый метод =====

class Utils
{
    // меняет местами два значения любого типа
    // ref нужен, чтобы менялись сами переменные, а не их копии
    public static void Swap<T>(ref T a, ref T b)
    {
        T temp = a;
        a = b;
        b = temp;
    }
}

// ===== Часть 3. Пара значений =====

// два типа: T1 и T2 (они могут быть разными)
class Pair<T1, T2>
{
    public T1 First;
    public T2 Second;

    public Pair(T1 first, T2 second)
    {
        First = first;
        Second = second;
    }
}

class Program
{
    static void Main()
    {
        Console.OutputEncoding = Encoding.UTF8;

        // ---------- Часть 1 ----------
        Box<int> intBox = new Box<int>();
        intBox.Put(42);

        Box<string> stringBox = new Box<string>();
        stringBox.Put("Hello");

        Console.WriteLine("Число в коробке: " + intBox.Get());
        Console.WriteLine("Строка в коробке: " + stringBox.Get());
        Console.WriteLine();

        // ---------- Часть 2 ----------
        int num1 = 5;
        int num2 = 10;
        Utils.Swap(ref num1, ref num2);
        Console.WriteLine("Числа после Swap: " + num1 + ", " + num2);

        string str1 = "Hello";
        string str2 = "World";
        Utils.Swap(ref str1, ref str2);
        Console.WriteLine("Строки после Swap: " + str1 + ", " + str2);
        Console.WriteLine();

        // ---------- Часть 3 ----------
        Pair<int, string> pair = new Pair<int, string>(5, "Hello");
        Console.WriteLine("Первое значение: " + pair.First + ", Второе значение: " + pair.Second);
    }
}
